    {
     "name": {
      "ru": "Теорема Виета",
      "en": "Vieta's theorem"
     },
     "formula": "x₁ + x₂ = −b/a,  x₁·x₂ = c/a",
     "lesson": "quadratic"
    },
    {
     "name": {
      "ru": "Разложение на множители",
      "en": "Factored form"
     },
     "formula": "ax² + bx + c = a(x − x₁)(x − x₂)",
     "lesson": "quadratic"
    },
    {
     "name": {
      "ru": "Вершина параболы",
      "en": "Vertex of a parabola"
     },
     "formula": "x₀ = −b/(2a),  y₀ = c − b²/(4a)",
     "lesson": "quadratic"
    },
    {
     "name": {
      "ru": "Знаки D",
      "en": "Signs of the discriminant"
     },
     "formula": "D > 0 — два корня, D = 0 — один, D < 0 — нет",
     "lesson": "quadratic"
