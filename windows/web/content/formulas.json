    {
     "name": {
      "ru": "Формула для корня при D > 0",
      "en": "Simplified root formula"
     },
     "formula": "x = (2c) : (−b ∓ √D) (знаменатель ≠ 0 / denominator ≠ 0)",
     "lesson": "quadratic"
    }
   ],
   "lessons": [
    "quadratic"
   ]
  },
