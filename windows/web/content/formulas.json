 "groups": [
  {
   "id": "powers",
   "ru": "Степени, корни, модуль",
   "en": "Powers, roots, absolute value",
   "items": [
    {
     "name": {
      "ru": "Произведение степеней",
      "en": "Product of powers"
     },
     "formula": "aᵐ · aⁿ = aᵐ⁺ⁿ",
     "lesson": "powers"
    },
    {
     "name": {
      "ru": "Частное степеней",
      "en": "Quotient of powers"
     },
     "formula": "aᵐ : aⁿ = aᵐ⁻ⁿ",
     "lesson": "powers"
    },
    {
     "name": {
      "ru": "Степень степени",
      "en": "Power of a power"
     },
     "formula": "(aᵐ)ⁿ = aᵐⁿ",
     "lesson": "powers"
    },
    {
     "name": {
      "ru": "Дробный показатель",
      "en": "Fractional exponent"
     },
     "formula": "a^(1/n) = ⁿ√a,  a^(m/n) = ⁿ√(aᵐ)",
     "lesson": "powers"
    },
    {
     "name": {
      "ru": "Корень из произведения",
      "en": "Root of a product"
     },
     "formula": "√(a·b) = √a · √b  (a, b ≥ 0)",
     "lesson": "roots-absolute"
    },
    {
     "name": {
      "ru": "Корень из частного",
      "en": "Root of a quotient"
     },
     "formula": "√(a : b) = √a : √b  (a ≥ 0, b > 0)",
     "lesson": "roots-absolute"
    },
    {
     "name": {
      "ru": "Квадрат корня",
      "en": "Square of a root"
     },
     "formula": "(√a)² = a (a ≥ 0);  √(a²) = |a|",
     "lesson": "roots-absolute"
    },
    {
     "name": {
      "ru": "Вынесение множителя",
      "en": "Extracting a factor"
     },
     "formula": "√(a²b) = |a|·√b (b ≥ 0)",
     "lesson": "roots-absolute"
    },
    {
     "name": {
      "ru": "Модуль",
      "en": "Absolute value"
     },
     "formula": "|x| = x при x ≥ 0;  |x| = −x при x < 0",
     "lesson": "roots-absolute"
    },
    {
     "name": {
      "ru": "Свойства модуля",
      "en": "Properties of |x|"
     },
     "formula": "|a·b| = |a|·|b|,  |a + b| ≤ |a| + |b|",
     "lesson": "roots-absolute"
    }
   ],
   "lessons": [
    "powers",
    "roots-absolute"
   ]
  },
  {
   "id": "multiplication",
