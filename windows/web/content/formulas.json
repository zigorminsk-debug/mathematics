     },
     "formula": "a² − b² = (a − b)(a + b)",
     "lesson": "identities"
    },
    {
     "name": {
      "ru": "Куб суммы",
      "en": "Cube of a sum"
     },
     "formula": "(a + b)³ = a³ + 3a²b + 3ab² + b³",
     "lesson": "identities"
    },
    {
     "name": {
      "ru": "Куб разности",
      "en": "Cube of a difference"
     },
     "formula": "(a − b)³ = a³ − 3a²b + 3ab² − b³",
     "lesson": "identities"
    },
    {
     "name": {
      "ru": "Сумма кубов",
      "en": "Sum of cubes"
     },
     "formula": "a³ + b³ = (a + b)(a² − ab + b²)",
     "lesson": "identities"
    },
    {
     "name": {
      "ru": "Разность кубов",
      "en": "Difference of cubes"
     },
     "formula": "a³ − b³ = (a − b)(a² + ab + b²)",
     "lesson": "identities"
    },
    {
     "name": {
      "ru": "Полный квадрат",
      "en": "Completing the square"
     },
     "formula": "ax² + bx + c = a(x + b/(2a))² − (b² − 4ac)/(4a)",
     "lesson": "identities"
    }
   ],
   "lessons": [
    "identities"
   ]
  },
  {
